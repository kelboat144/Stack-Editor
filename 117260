package stackeditor;

import javax.swing.AbstractAction;
import javax.swing.BorderFactory;
import javax.swing.JButton;
import javax.swing.JFrame;
import javax.swing.JLabel;
import javax.swing.JPanel;
import javax.swing.JScrollPane;
import javax.swing.JSplitPane;
import javax.swing.JTextArea;
import javax.swing.JToolBar;
import javax.swing.border.TitledBorder;
import javax.swing.event.DocumentEvent;
import javax.swing.event.DocumentListener;
import javax.swing.text.AbstractDocument;
import javax.swing.text.AttributeSet;
import javax.swing.text.BadLocationException;
import javax.swing.text.DefaultHighlighter;
import javax.swing.text.DocumentFilter;
import javax.swing.text.Highlighter;
import java.awt.BorderLayout;
import java.awt.Color;
import java.awt.Font;
import java.awt.GridLayout;
import java.awt.Toolkit;
import java.awt.event.ActionEvent;
import java.awt.event.KeyEvent;
import java.util.List;
import javax.swing.KeyStroke;

/**
 * Mini text editor that uses stacks in two ways:
 *  1. an undo stack and a redo stack hold the editing history;
 *  2. a bracket stack checks (), [] and {} while you type.
 */
public final class EditorFrame extends JFrame {

    private static final String SAMPLE =
            "public static int sum(int[] a) {\n"
          + "    int total = 0;\n"
          + "    for (int i = 0; i < a.length; i++) {\n"
          + "        total += a[i];\n"
          + "    }\n"
          + "    return total;\n"
          + "}\n";

    private final JTextArea editor = new JTextArea();
    private final ArrayStack<EditAction> undoStack = new ArrayStack<>();
    private final ArrayStack<EditAction> redoStack = new ArrayStack<>();
    private boolean applying = false; // true while undo/redo itself edits the text

    private final JButton undoButton = new JButton("Undo");
    private final JButton redoButton = new JButton("Redo");

    private final JTextArea undoView = makeView();
    private final JTextArea redoView = makeView();
    private final JTextArea bracketView = makeView();
    private final TitledBorder undoBorder = BorderFactory.createTitledBorder("");
    private final TitledBorder redoBorder = BorderFactory.createTitledBorder("");
    private final TitledBorder bracketBorder = BorderFactory.createTitledBorder("");

    private final JLabel status = new JLabel(" ");
    private final Highlighter.HighlightPainter errorPainter =
            new DefaultHighlighter.DefaultHighlightPainter(new Color(255, 160, 160));

    public EditorFrame() {
        super("Stack Editor - undo/redo and bracket checking");
        setDefaultCloseOperation(EXIT_ON_CLOSE);

        editor.setFont(new Font(Font.MONOSPACED, Font.PLAIN, 16));
        editor.setTabSize(4);
        editor.setMargin(new java.awt.Insets(8, 8, 8, 8));

        installHistoryRecorder();
        installKeyBindings();
        buildLayout();

        editor.getDocument().addDocumentListener(new DocumentListener() {
            public void insertUpdate(DocumentEvent e) { refresh(); }
            public void removeUpdate(DocumentEvent e) { refresh(); }
            public void changedUpdate(DocumentEvent e) { refresh(); }
        });
        editor.addCaretListener(e -> refreshBracketView());

        setSize(1050, 640);
        setLocationRelativeTo(null);
        refresh();
    }

    // ---------- history recording (push onto the undo stack) ----------

    private void installHistoryRecorder() {
        ((AbstractDocument) editor.getDocument()).setDocumentFilter(new DocumentFilter() {
            @Override
            public void insertString(FilterBypass fb, int offset, String text, AttributeSet attrs)
                    throws BadLocationException {
                replace(fb, offset, 0, text, attrs);
            }

            @Override
            public void remove(FilterBypass fb, int offset, int length) throws BadLocationException {
                replace(fb, offset, length, "", null);
            }

            @Override
            public void replace(FilterBypass fb, int offset, int length, String text, AttributeSet attrs)
                    throws BadLocationException {
                String inserted = text == null ? "" : text;
                String removed = fb.getDocument().getText(offset, length);
                if (length == 0 && inserted.isEmpty()) return;
                if (!applying) {
                    undoStack.push(new EditAction(offset, removed, inserted)); // PUSH
                    redoStack.clear();                                         // a new edit ends the redo chain
                }
                super.replace(fb, offset, length, inserted, attrs);
            }
        });
    }

    // ---------- undo / redo (pop from one stack, push onto the other) ----------

    private void undo() {
        if (undoStack.isEmpty()) return;
        EditAction a = undoStack.pop();                       // POP
        applyReplace(a.offset, a.inserted.length(), a.removed);
        redoStack.push(a);                                    // PUSH onto redo
        editor.setCaretPosition(a.offset + a.removed.length());
        refresh();
    }

    private void redo() {
        if (redoStack.isEmpty()) return;
        EditAction a = redoStack.pop();                       // POP
        applyReplace(a.offset, a.removed.length(), a.inserted);
        undoStack.push(a);                                    // PUSH back onto undo
        editor.setCaretPosition(a.offset + a.inserted.length());
        refresh();
    }

    private void applyReplace(int offset, int length, String text) {
        applying = true;
        try {
            ((AbstractDocument) editor.getDocument()).replace(offset, length, text, null);
        } catch (BadLocationException ex) {
            throw new IllegalStateException(ex);
        } finally {
            applying = false;
        }
    }

    private void loadSample() {
        editor.setText(SAMPLE); // recorded as one undoable edit
        editor.setCaretPosition(0);
    }

    private void resetAll() {
        applying = true;
        try {
            editor.setText("");
        } finally {
            applying = false;
        }
        undoStack.clear();
        redoStack.clear();
        refresh();
    }

    // ---------- UI ----------

    private void installKeyBindings() {
        int mask = Toolkit.getDefaultToolkit().getMenuShortcutKeyMaskEx();
        editor.getInputMap().put(KeyStroke.getKeyStroke(KeyEvent.VK_Z, mask), "stack-undo");
        editor.getInputMap().put(KeyStroke.getKeyStroke(KeyEvent.VK_Y, mask), "stack-redo");
        editor.getInputMap().put(KeyStroke.getKeyStroke(KeyEvent.VK_Z, mask | KeyEvent.SHIFT_DOWN_MASK), "stack-redo");
        editor.getActionMap().put("stack-undo", new AbstractAction() {
            public void actionPerformed(ActionEvent e) { undo(); }
        });
        editor.getActionMap().put("stack-redo", new AbstractAction() {
            public void actionPerformed(ActionEvent e) { redo(); }
        });
    }

    private void buildLayout() {
        undoButton.setToolTipText("Ctrl+Z");
        redoButton.setToolTipText("Ctrl+Y");
        undoButton.addActionListener(e -> { undo(); editor.requestFocusInWindow(); });
        redoButton.addActionListener(e -> { redo(); editor.requestFocusInWindow(); });
        JButton sampleButton = new JButton("Load sample");
        sampleButton.addActionListener(e -> { loadSample(); editor.requestFocusInWindow(); });
        JButton resetButton = new JButton("Reset");
        resetButton.setToolTipText("Clear the text and both stacks");
        resetButton.addActionListener(e -> { resetAll(); editor.requestFocusInWindow(); });

        JToolBar bar = new JToolBar();
        bar.setFloatable(false);
        bar.add(undoButton);
        bar.add(redoButton);
        bar.addSeparator();
        bar.add(sampleButton);
        bar.add(resetButton);

        undoView.setToolTipText("Top of the stack is listed first");
        JPanel side = new JPanel(new GridLayout(3, 1, 0, 6));
        side.add(wrap(undoView, undoBorder));
        side.add(wrap(redoView, redoBorder));
        side.add(wrap(bracketView, bracketBorder));

        JSplitPane split = new JSplitPane(JSplitPane.HORIZONTAL_SPLIT, new JScrollPane(editor), side);
        split.setResizeWeight(0.65);

        status.setOpaque(true);
        status.setBorder(BorderFactory.createEmptyBorder(6, 10, 6, 10));
        status.setFont(status.getFont().deriveFont(Font.BOLD, 14f));

        JPanel root = new JPanel(new BorderLayout());
        root.add(bar, BorderLayout.NORTH);
        root.add(split, BorderLayout.CENTER);
        root.add(status, BorderLayout.SOUTH);
        setContentPane(root);
    }

    private static JTextArea makeView() {
        JTextArea area = new JTextArea();
        area.setEditable(false);
        area.setFont(new Font(Font.MONOSPACED, Font.PLAIN, 13));
        return area;
    }

    private static JScrollPane wrap(JTextArea area, TitledBorder border) {
        JScrollPane sp = new JScrollPane(area);
        sp.setBorder(border);
        return sp;
    }

    // ---------- refresh everything that depends on the stacks or the text ----------

    private void refresh() {
        undoButton.setEnabled(!undoStack.isEmpty());
        redoButton.setEnabled(!redoStack.isEmpty());

        undoBorder.setTitle("Undo stack (" + undoStack.size() + ")  - top first");
        redoBorder.setTitle("Redo stack (" + redoStack.size() + ")  - top first");
        undoView.setText(describe(undoStack));
        redoView.setText(describe(redoStack));
        undoView.setCaretPosition(0);
        redoView.setCaretPosition(0);

        checkBrackets();
        refreshBracketView();
        repaint();
    }

    private static String describe(ArrayStack<EditAction> stack) {
        if (stack.isEmpty()) return "(empty)";
        StringBuilder sb = new StringBuilder();
        List<EditAction> items = stack.toListTopFirst();
        int shown = Math.min(items.size(), 100);
        for (int i = 0; i < shown; i++) {
            sb.append(i == 0 ? "\u25B6 " : "  ").append(items.get(i).describe()).append('\n');
        }
        if (items.size() > shown) sb.append("  ... ").append(items.size() - shown).append(" more");
        return sb.toString();
    }

    private void checkBrackets() {
        BracketChecker.Result r = BracketChecker.check(editor.getText());
        Highlighter h = editor.getHighlighter();
        h.removeAllHighlights();
        if (r.balanced) {
            status.setBackground(new Color(214, 240, 214));
            status.setForeground(new Color(20, 100, 20));
            status.setText("\u2714  " + r.message);
        } else {
            status.setBackground(new Color(250, 214, 214));
            status.setForeground(new Color(150, 20, 20));
            status.setText("\u2718  " + r.message);
            try {
                h.addHighlight(r.errorPos, r.errorPos + 1, errorPainter);
            } catch (BadLocationException ignored) {
                // position vanished while typing; the next refresh fixes it
            }
        }
    }

    private void refreshBracketView() {
        List<BracketChecker.Entry> open =
                BracketChecker.openBracketsBefore(editor.getText(), editor.getCaretPosition());
        bracketBorder.setTitle("Bracket stack at cursor (" + open.size() + " open)");
        if (open.isEmpty()) {
            bracketView.setText("(empty)");
        } else {
            StringBuilder sb = new StringBuilder();
            for (int i = 0; i < open.size(); i++) {
                BracketChecker.Entry e = open.get(i);
                sb.append(i == 0 ? "\u25B6 " : "  ").append('\'').append(e.ch).append("'  opened at ")
                  .append(BracketChecker.lineCol(editor.getText(), e.pos)).append('\n');
            }
            bracketView.setText(sb.toString());
        }
        bracketView.setCaretPosition(0);
        bracketView.getParent().getParent().repaint();
    }
}
